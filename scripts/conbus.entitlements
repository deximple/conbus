<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A landed hop opens Terminal through osascript. Under the hardened
	     runtime, macOS attributes those Apple events to conbus when the
	     recorder started it, and refuses them without this. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
